rules_version = '2';
// RentSafe Pro Storage
//  - members/{uid}/** : 회원 본인 쓰기, 인증 사용자 읽기
//  - consent_photos/** : 서버(Admin SDK) 업로드 전제 → 클라이언트 직접 write 금지
service firebase.storage {
  match /b/{bucket}/o {
    match /members/{uid}/{file=**} {
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
      allow read: if request.auth != null;
    }

    match /consent_photos/{consentId}/{file=**} {
      allow write: if false;
      // 다운로드 URL 토큰이 있으면 토큰으로 접근. 규칙상 인증 회원만 list/get.
      allow read: if request.auth != null;
    }
  }
}
