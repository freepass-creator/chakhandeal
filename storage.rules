rules_version = '2';
// 착한거래(chakhandeal) Storage
//  - members/{uid}/** : 회원 본인 쓰기, 인증 사용자 읽기
//  - consent_photos/** : 서버(Admin SDK) 업로드 전제 → 클라이언트 직접 write 금지
service firebase.storage {
  match /b/{bucket}/o {
    match /members/{uid}/{file=**} {
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
      allow read: if request.auth != null && (request.auth.uid == uid
                   || request.auth.token.email == 'dudguq@gmail.com');
    }

    match /consent_photos/{consentId}/{file=**} {
      allow write: if false;
      // 열람은 서명 URL(Admin) 또는 관리자. 임의 회원 전체 열람 금지.
      allow read: if request.auth != null && request.auth.token.email == 'dudguq@gmail.com';
    }

    /**
     * 전자계약 증적 — 신분증 · 얼굴 · 서명 · 제출서류(등본·가족관계·통장사본).
     * **클라이언트 직접 접근 전면 금지.** 서버(Admin SDK)만 읽고 쓴다.
     * 당사자(본인 · 발행 회원사)에게는 서버가 «만료되는 서명 URL»로만 내준다.
     * 규칙이 없어도 기본값은 거부지만, 무엇이 들어가는 경로인지 명시해 둔다 —
     * 나중에 누가 「일단 열어보자」고 손대는 것을 막는 표지다.
     */
    match /contracts/{contractId}/{file=**} {
      allow read, write: if false;
    }

    // 매치되지 않은 경로도 기본 거부다. 새 경로를 만들면 «여기에» 규칙을 적는다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
