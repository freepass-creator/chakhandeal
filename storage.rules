rules_version = '2';
// 착한딜(chakhandeal) Storage
//  - members/{uid}/** : 회원 본인 쓰기, 인증 사용자 읽기
//  - consent_photos/** : 서버(Admin SDK) 업로드 전제 → 클라이언트 직접 write 금지
service firebase.storage {
  match /b/{bucket}/o {
    match /members/{uid}/{file=**} {
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
      allow read: if request.auth != null && (request.auth.uid == uid
                   || request.auth.token.email == 'dudguq@gmail.com');
    }

    match /consent_photos/{consentId}/{file=**} {
      allow write: if false;
      // 열람은 서명 URL(Admin) 또는 관리자. 임의 회원 전체 열람 금지.
      allow read: if request.auth != null && request.auth.token.email == 'dudguq@gmail.com';
    }
  }
}
