# 착한거래(chakhandeal) 환경변수 — 이 파일을 복사해 .env.local 로 만들고 값을 채우세요 (.env.local 커밋 금지)

# ── 시크릿 (서버 전용, 운영에서 각각 다른 랜덤값 필수) ──
# 미설정이면: 시연(DEMO)에서는 임시 폴백/부팅랜덤으로 동작, 운영(DEMO 끔)에서는 기동 실패.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MATCH_HMAC_SECRET=          # 이름+생년월일 매칭키 HMAC (여기에 예시 상수를 넣지 말 것)
SESSION_SIGNING_SECRET=     # 세션 토큰 서명키 (MATCH_HMAC_SECRET와 반드시 다른 값)
IDENTITY_SIGNING_SECRET=    # 본인확인(IdV) 토큰 서명키 (위 둘과 반드시 다른 값)

# ── 데모/운영 스위치 ──
# NEXT_PUBLIC_DEMO_MODE=false  # 운영 배포 시 필수 — 데모 로그인·샘플·무인증 조회 표면을 닫음
# ALLOW_PUBLIC_CHECK=1         # 이름·생일 공개 조회(/api/v1/check) — 로컬 데모용
# ALLOW_DEMO_LOGIN=1           # 하드코딩 데모 계정 로그인 — 로컬 데모용

# ── Firebase Admin (서버). 없으면 mock 스토어로 동작 ──
# 서비스계정 JSON 전체를 한 줄로, 또는 파일 경로
# FIREBASE_ADMIN_JSON={"type":"service_account",...}
# FIREBASE_ADMIN_PATH=./service-account.json

# ── Firebase 클라이언트 (웹) ──
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_STORAGE_BUCKET=
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FB_APP_ID=

# ── Gemini OCR (서버 전용) ──
GEMINI_API_KEY=
