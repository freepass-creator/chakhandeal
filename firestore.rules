rules_version = '2';
// 착한거래(chakhandeal) — 서버(Admin SDK) 경유 전제
//  - risks/consents/certificates/pii_vault/company_keys: 클라 전면 차단
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'dudguq@gmail.com';
    }
    function isSignedIn() { return request.auth != null; }

    match /members/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    match /consents/{id} {
      allow create, read, update, delete: if false;
    }

    match /risks/{id} {
      allow read, create, update, delete: if false;
    }

    match /appeals/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /audits/{id} {
      allow read, write: if false;
    }

    match /certificates/{id} {
      allow read, create, update, delete: if false;
    }

    // PII 금고 — 서버(Admin SDK) 전용
    match /pii_vault/{id} {
      allow read, create, update, delete: if false;
    }

    // 회사별 토큰 키 — 서버 전용
    match /company_keys/{id} {
      allow read, create, update, delete: if false;
    }
  }
}
