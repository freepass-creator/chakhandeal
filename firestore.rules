rules_version = '2';
// 착한거래(chakhandeal) — 서버(Admin SDK) 경유 전제
//  - risks/consents/certificates/pii_vault/company_keys: 클라 전면 차단
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'dudguq@gmail.com';
    }
    function isSignedIn() { return request.auth != null; }

    match /members/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    match /consents/{id} {
      allow create, read, update, delete: if false;
    }

    match /risks/{id} {
      allow read, create, update, delete: if false;
    }

    match /appeals/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /audits/{id} {
      allow read, write: if false;
    }

    match /certificates/{id} {
      allow read, create, update, delete: if false;
    }

    // PII 금고 — 서버(Admin SDK) 전용
    match /pii_vault/{id} {
      allow read, create, update, delete: if false;
    }

    // 회사별 토큰 키 — 서버 전용
    match /company_keys/{id} {
      allow read, create, update, delete: if false;
    }

    /**
     * 전자계약 인스턴스 — 계약 내용 · 손님 입력 · 동의 · 봉인(atoms/a4/certificate).
     * 손님 화면도 **서버 API를 거쳐서만** 읽는다(추측 불가한 contractId 가 열쇠).
     * 클라이언트가 Firestore 를 직접 읽게 두면 링크 하나로 계약 전문이 새 나간다.
     */
    match /contracts/{id} {
      allow read, create, update, delete: if false;
    }

    // 테스트 렌더러(/labs)가 남기는 것 — 운영에서는 쓰지 않는다.
    match /lab_contracts/{id} {
      allow read, create, update, delete: if false;
    }

    // 매치되지 않은 경로도 기본 거부다. 새 컬렉션을 만들면 «여기에» 규칙을 적는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
